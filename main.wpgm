import wollok.game.*
import videojuegoGRUPO5.*


program videojuego {

	game.width(10)
	game.height(10)
	game.cellSize(50)
   
	game.addVisual(autoADerecha)
	game.addVisual(autoAIzquierda)
	

	game.addVisual(alumno)
	game.addVisual(unq)
	game.onCollideDo(alumno, {alumno => alumno.perderVida()})
	autoADerecha.moverDerecha() 
	autoAIzquierda.moverIzquierda() 
	keyboard.left().onPressDo({alumno.mover(izquierda)})
	keyboard.right().onPressDo({alumno.mover(derecha)})
	keyboard.up().onPressDo({alumno.mover(arriba)})
	keyboard.down().onPressDo({alumno.mover(abajo)})


	game.start()

}