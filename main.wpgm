import wollok.game.*
import example.*


program videojuego {

	game.width(10)
	game.height(10)
	game.cellSize(50)
    game.ground("fondo")
	
	game.addVisual(auto1)
	game.addVisual(alumno)

	
	game.onCollideDo(pepita, {algo => algo.interactuar(alumno)})
	keyboard.space().onPressDo({alumno.saludar()})
	
	keyboard.left().onPressDo({alumno.mover(izquierda)})
	keyboard.right().onPressDo({alumno.mover(derecha)})
	keyboard.up().onPressDo({alumno.mover(arriba)})
	keyboard.down().onPressDo({alumno.mover(abajo)})


	game.start()

}